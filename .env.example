# Local SNAP configuration template
# Copy this file to .env and adjust values for your machine.

# SNAP installation root (default: C:\Program Files\esa-snap)
SNAP_DIRECTORY=C:\Program Files\esa-snap

# Copernicus Data Space Ecosystem credentials (get them from https://dataspace.copernicus.eu/)
CDSE_USERNAME=your-cdse-username-here
CDSE_PASSWORD=your-cdse-password-here

# Sentinel Hub credentials (get them from https://shapps.dataspace.copernicus.eu/dashboard/#/)
SH_CLIENT_SECRET=your-client-secret-here
SH_CLIENT_ID=your-client-id-here
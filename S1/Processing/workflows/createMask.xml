  <node id="BandMaths">
      <operator>BandMaths</operator>
      <sources>
        <sourceProduct refid="BandMerge"/>
      </sources>
      <parameters class="com.bc.ceres.binding.dom.XppDomElement">
        <targetBands>
          <targetBand>
            <name>Flood</name>
            <type>float32</type>
            <expression>
              <!-- if ${hasDataAtPixel}
              AND land_cover_ESA_WorldCover != 80
              AND elevation &lt; elev_threshold
              AND slope_mask == 1
              AND (
                (land_cover_ESA_WorldCover == 50 AND ${vh_diff} &lt; (otsu_vh_threshold - 0.15) AND ${vv_diff} &lt; (otsu_vv_threshold - 0.15))
                OR
                (land_cover_ESA_WorldCover != 50 AND ${vh_diff} &lt; (otsu_vh_threshold - 0.03) AND ${vv_diff} &lt; (otsu_vv_threshold - 0.03))
              )
              then 1
              else 0 -->
              if ${hasDataAtPixel}
              AND land_cover_ESA_WorldCover != 80
              AND elevation &lt; elev_threshold
              AND slope_mask == 1
              AND (
                (land_cover_ESA_WorldCover == 50 AND ${vh_diff} &lt; (otsu_vh_threshold - 0.15) AND ${vv_diff} &lt; (otsu_vv_threshold - 0.15))
                OR
                (land_cover_ESA_WorldCover == 10 AND ${vh_diff} &lt; (otsu_vh_threshold - 0.20) AND ${vv_diff} &lt; (otsu_vv_threshold - 0.20))
                OR
                (land_cover_ESA_WorldCover != 50 AND land_cover_ESA_WorldCover != 10 AND ${vh_diff} &lt; (otsu_vh_threshold - 0.03) AND ${vv_diff} &lt; (otsu_vv_threshold - 0.03))
              )
              then 1 else 0
            </expression>
          </targetBand>
        </targetBands>
      </parameters>
    </node>
    <node id="Write">
      <operator>Write</operator>
      <sources>
        <sourceProduct refid="BandMaths"/>
      </sources>
      <parameters class="com.bc.ceres.binding.dom.XppDomElement">

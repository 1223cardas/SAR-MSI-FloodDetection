<graph id="Graph">
  <version>1.0</version>
  <node id="Read">
    <operator>Read</operator>
    <sources/>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
      <useAdvancedOptions>false</useAdvancedOptions>
      <file>${product}</file>
      <copyMetadata>true</copyMetadata>
      <bandNames/>
      <maskNames/>
    </parameters>
  </node>
  <node id="BandMaths">
    <operator>BandMaths</operator>
    <sources>
      <sourceProduct.2 refid="Read"/>
    </sources>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
      <targetBands>
        <targetBand>
          <name>Flood</name>
          <type>float32</type>
          <expression>
            if land_cover_ESA_WorldCover != 80 AND (${vh_slv} &gt; 0 AND ${vh_mst} &gt; 0) AND elevation &lt; ${elev_threshold}
                AND (${vh_diff} &lt; -3 OR (${vh_diff} &lt; -2 AND ${vv_diff} &lt; -3))
            then 1 else NaN
          </expression>
          <description>Flood Mask</description>
          <unit/>
          <noDataValue>0</noDataValue>
        </targetBand>
      </targetBands>
      <variables/>
    </parameters>
  </node>
  <node id="Write">
    <operator>Write</operator>
    <sources>
      <sourceProduct refid="BandMaths"/>
    </sources>
    <parameters class="com.bc.ceres.binding.dom.XppDomElement">
      <file>${output}</file>
      <formatName>BEAM-DIMAP</formatName>
    </parameters>
  </node>
  <applicationData id="Presentation">
    <Description/>
    <node id="Read">
      <displayPosition x="77.0" y="154.0"/>
    </node>
    <node id="BandMaths">
      <displayPosition x="305.0" y="155.0"/>
    </node>
    <node id="Write">
      <displayPosition x="450.0" y="153.0"/>
    </node>
  </applicationData>
</graph>